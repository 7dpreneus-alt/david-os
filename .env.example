# Personal Mission Control OS — environment variables
#
# Copy to .env.local and fill in. NEVER commit .env.local or any real secret.
# Every variable is validated at startup by lib/env.ts; the app fails fast
# rather than starting in a degraded or fake mode.
#
# See docs/personal-mission-control-os/ENVIRONMENT_VARIABLES.md for the
# authoritative table.

# ----------------------------------------------------------------- core app
NEXT_PUBLIC_APP_NAME="Personal Mission Control OS"
# development | test | preview | production
NEXT_PUBLIC_APP_ENV=development
# Canonical origin. Must be https and not localhost in production.
APP_URL=http://localhost:3000
# debug | info | warn | error
LOG_LEVEL=info
# Commit SHA, surfaced on /system/status. CI should set this.
BUILD_SHA=

# ------------------------------------------------------------------ database
# PostgreSQL connection used by the application at runtime. Queries run as the
# `authenticated` role with request.jwt.claims set, so RLS is enforced.
# Supabase: use the pooled connection string from Project Settings → Database.
DATABASE_URL=
# Direct (non-pooled) connection, used for migrations only.
DIRECT_DATABASE_URL=
# Local development only: the connection string printed by `pnpm db:local:start`.
LOCAL_DATABASE_URL=

# ------------------------------------------------------------------ identity
# supabase (deployment default) | local (development and CI only).
# `local` is refused at startup in preview and production.
AUTH_PROVIDER=local
# Required when AUTH_PROVIDER=local. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
AUTH_SESSION_SECRET=
AUTH_SESSION_TTL_HOURS=72

# Required when AUTH_PROVIDER=supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Never expose through a NEXT_PUBLIC_ name and never bundle.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------- Google Calendar (Milestone 4)
# Required only when FEATURE_CALENDAR_READ=true; startup fails without them.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Must equal ${APP_URL}/api/v1/calendar/google/callback and be registered
# exactly in the Google Cloud console.
GOOGLE_OAUTH_REDIRECT_URI=
# At least 32 characters of randomness; signs the single-use OAuth state.
GOOGLE_OAUTH_STATE_SECRET=
# Active token-encryption key version (positive integer).
TOKEN_ENCRYPTION_ACTIVE_VERSION=
# Base64 of exactly 32 random bytes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY_V1=
# Add V2 during rotation; keep V1 until every row is re-encrypted.
TOKEN_ENCRYPTION_KEY_V2=
# Initial sync window.
CALENDAR_SYNC_PAST_DAYS=90
CALENDAR_SYNC_FUTURE_DAYS=365

# -------------------------------------------------------------- feature flags
# Parsed as strict booleans: only "true" or "false".
FEATURE_CALENDAR_READ=false
FEATURE_CALENDAR_WRITE=false
FEATURE_BACKGROUND_JOBS=false
FEATURE_BROWSER_NOTIFICATIONS=false
FEATURE_EMAIL_NOTIFICATIONS=false
FEATURE_WEEKLY_REVIEW=false
FEATURE_OPPORTUNITY_RADAR=false
FEATURE_STARTER_DATA=true
FEATURE_ACCOUNT_DELETION=false

# ------------------------------------------------------------ end-to-end test
E2E_BASE_URL=http://localhost:3000
E2E_USER_EMAIL=
E2E_USER_PASSWORD=
